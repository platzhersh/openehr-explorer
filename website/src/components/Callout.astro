---
// The "note" / "warning" callout boxes used throughout docs.html.
interface Props {
  kind?: "note" | "warning";
  title: string;
}
const { kind = "note", title } = Astro.props;
---

<div class:list={[kind]}>
  <div class="callout-title">{title}</div>
  <slot />
</div>

<style>
  .note {
    border-left: 3px solid var(--primary);
    background: rgba(100, 255, 218, 0.05);
    padding: 12px 16px;
    border-radius: 0 var(--radius) var(--radius) 0;
    margin: 16px 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  .warning {
    border-left: 3px solid var(--warning);
    background: rgba(255, 217, 61, 0.05);
    padding: 12px 16px;
    border-radius: 0 var(--radius) var(--radius) 0;
    margin: 16px 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  .callout-title {
    font-weight: 600;
    color: var(--text);
    margin-bottom: 4px;
  }
</style>
