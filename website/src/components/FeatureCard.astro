---
// One tile in the landing page's feature grid. Previously six copies of
// this markup were hand-written inline; the page now maps over a plain
// data array (see src/pages/index.astro) instead.
interface Props {
  icon: string;
  title: string;
  /** Optional docs link; the title becomes a link and the whole card clickable. */
  href?: string;
}
const { icon, title, href } = Astro.props;
---

<div class:list={["feature-card", { linked: href }]}>
  <div class="feature-icon" aria-hidden="true">{icon}</div>
  <h3>{href ? <a href={href}>{title}</a> : title}</h3>
  <p><slot /></p>
</div>

<style>
  .feature-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 28px;
    transition: border-color 0.2s;
  }
  .feature-card:hover {
    border-color: var(--primary-dim);
  }
  .feature-card.linked {
    position: relative;
  }
  .feature-card h3 a {
    color: inherit;
    text-decoration: none;
  }
  /* Stretch the title link over the whole card so it is one click target. */
  .feature-card h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 10px;
  }
  .feature-card h3 a:hover {
    color: var(--primary);
  }
  .feature-card h3 a:focus-visible::after {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .feature-icon {
    font-size: 1.8rem;
    margin-bottom: 12px;
  }
  .feature-card h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--text);
  }
  .feature-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>
