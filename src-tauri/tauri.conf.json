{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openEHR Explorer",
  "version": "0.4.2",
  "identifier": "com.openehr-explorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "openEHR Explorer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src ipc: http://ipc.localhost https: http:; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data: https://cdn.jsdelivr.net https://unpkg.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "homepage": "https://platzhersh.github.io/openehr-explorer/",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/platzhersh/openehr-explorer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJERDgzRkEwNzgyOTYyOEYKUldTUFlpbDRvRC9ZdllaL1Uxc01HQ1dHUTFYZ01oNXYxY2cyd2pwL3Rhc3drTnNRbUwyOHE0dTMK"
    }
  }
}
