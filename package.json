  "version": "0.8.0",
  "type": "module",
  "homepage": "https://openehr-explorer.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/platzhersh/openehr-explorer"
  },
  "scripts": {
    "dev": "vite",
    "dev:analytics": "bash scripts/dev-with-analytics.sh",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "fmt": "oxfmt --write src/",
    "fmt:check": "oxfmt --check src/",
    "test": "vitest run",
    "demo:screenshots": "node scripts/demo-assets/capture-screenshots.js",
    "demo:video": "node scripts/demo-assets/record-video.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.1",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.41.0",
    "@lezer/highlight": "1.2.3",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-opener": "2.5.3",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "codemirror": "6.0.2",
    "pinia": "3.0.4",
    "vue": "3.5.31",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/vue3-vite": "10.5.10",
    "@tauri-apps/cli": "2.11.1",
    "@vitejs/plugin-vue": "6.0.8",
    "oxfmt": "0.43.0",
    "oxlint": "1.58.0",
    "playwright": "1.56.1",
    "storybook": "10.5.10",
    "typescript": "5.6.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.9"
  }
