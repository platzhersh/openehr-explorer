{
  "name": "openehr-explorer",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.10.1",
  "type": "module",
  "homepage": "https://openehr-explorer.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/platzhersh/openehr-explorer"
  },
  "scripts": {
    "dev": "vite",
    "dev:analytics": "bash scripts/dev-with-analytics.sh",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "fmt": "oxfmt --write src/",
    "fmt:check": "oxfmt --check src/",
    "test": "vitest run",
    "demo:screenshots": "node scripts/demo-assets/capture-screenshots.js",
    "demo:video": "node scripts/demo-assets/record-video.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:a11y": "node scripts/a11y-storybook.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "codemirror": "6.0.2",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/vue3-vite": "10.6.6",
    "@tauri-apps/cli": "2.12.4",
    "@vitejs/plugin-vue": "6.0.10",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "playwright": "1.65.0",
    "storybook": "10.6.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
