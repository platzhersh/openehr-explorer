# Maintainer: platzhersh
#
# Pre-built binary package (installs the same .deb produced by the Tauri
# release CI, extracted rather than rebuilt) — AUR convention requires the
# -bin suffix for packages that ship pre-compiled binaries instead of
# building from source. Building this app from source at package-build time
# isn't practical for AUR: it needs network access (npm/cargo fetch) during
# the build step, which AUR's clean-chroot build disallows.
#
# See OEH-12: https://github.com/platzhersh/openehr-explorer for source.

pkgname=open-ehr-explorer-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="A native desktop app for browsing, querying, and inspecting openEHR CDR instances"
arch=('x86_64' 'aarch64')
url="https://openehr-explorer.dev/"
license=('Apache-2.0')
provides=('open-ehr-explorer')
conflicts=('open-ehr-explorer')
# Matches the real Depends: field in the .deb's control file
# (libwebkit2gtk-4.1-0, libgtk-3-0) — verified against the v0.5.0 build.
depends=('webkit2gtk-4.1' 'gtk3')
options=('!strip' '!emptydirs')
# Per-architecture sources: the release CI publishes an amd64 and an arm64
# .deb. The aarch64 checksum is 'SKIP' until the first release that ships an
# arm64 .deb — replace it with the real digest (see README.md) before
# publishing that release to the AUR.
source_x86_64=("https://github.com/platzhersh/openehr-explorer/releases/download/v${pkgver}/openEHR.Explorer_${pkgver}_amd64.deb")
source_aarch64=("https://github.com/platzhersh/openehr-explorer/releases/download/v${pkgver}/openEHR.Explorer_${pkgver}_arm64.deb")
sha256sums_x86_64=('b1d444bd6d669c0df007af25f5ca211284d51411aa32ed0f4b0c2f89ed8ff3b7')
sha256sums_aarch64=('SKIP')

package() {
  # .deb is an `ar` archive containing debian-binary, control.tar.*, and
  # data.tar.* — unpack the outer ar first, then the inner data tarball
  # (whose compression varies by dpkg version, hence the glob) straight
  # into the package dir. Same file contents apt would install.
  case "$CARCH" in
    x86_64) _debarch=amd64 ;;
    aarch64) _debarch=arm64 ;;
  esac
  bsdtar -xf "openEHR.Explorer_${pkgver}_${_debarch}.deb"
  tar -xf data.tar.* -C "${pkgdir}"
}
